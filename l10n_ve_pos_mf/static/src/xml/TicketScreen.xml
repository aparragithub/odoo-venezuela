<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension" owl="1">
        <!--
            Odoo 19: la estructura interna de TicketScreen cambio bastante
            respecto a v17 (nombre de template point_of_sale.TicketScreen en
            vez de TicketScreen a secas; no existe ReprintReceiptButton; no
            hay una fila de encabezado de columnas explicita). Se simplifica
            la vista a lo esencial: agregar los botones de Web Serial
            (reimprimir / imprimir pendiente) en el panel de acciones del
            pedido seleccionado.
        -->
        <xpath expr="//div[hasclass('control-buttons')][1]" position="inside">
            <t t-if="_selectedSyncedOrder">
                <t t-if="(_selectedSyncedOrder.totalDue ?? _selectedSyncedOrder.get_total_with_tax?.()) > 0">
                    <ReprintInvoiceButton order="_selectedSyncedOrder" />
                </t>
                <t t-if="!_selectedSyncedOrder.mf_invoice_number">
                    <PrintPendingOrderButton order="_selectedSyncedOrder" onOrderFiscalized.bind="onOrderFiscalized" />
                </t>
            </t>
        </xpath>
        <!--
            El boton nativo "Invoice" (permite facturar un recibo despues del
            hecho) es redundante: l10n_ve_pos ya fuerza to_invoice=true en
            todo pedido (ver overrides/models/pos_order.js, HC.5), por lo que
            todo pedido ya se factura automaticamente.
        -->
        <xpath expr="//InvoiceButton[1]" position="replace"></xpath>
    </t>
</templates>
