<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension" owl="1">
        <!--
            Odoo 19: la estructura de ReceiptScreen cambio respecto a v17
            (clases nuevas o_payment_successful / receipt-options). Se usa
            un xpath por clase en vez de posicional (fragil) para ubicar el
            banner de factura fiscal.
        -->
        <xpath expr="//div[hasclass('o_payment_successful')]" position="inside">
            <div t-if="currentOrder.mf_invoice_number" class="text-center d-flex flex-column align-items-center mt-3 p-3 bg-light border rounded shadow-sm">
                <div class="fw-bold fs-5 text-success mb-2">
                    <t t-if="(currentOrder.totalDue ?? currentOrder.get_total_with_tax?.()) &lt; 0">Nota de Crédito Impresa</t>
                    <t t-else="">Factura Fiscal Impresa</t>
                </div>
                <p class="fw-bold mb-1" style="font-size: 1.15rem;">
                    Nro: <span class="text-primary"><t t-out="currentOrder.mf_invoice_number"/></span>
                </p>
                <p t-if="currentOrder.fiscal_machine" class="text-muted mb-1" style="font-size: 0.9rem; font-weight: normal;">
                    Serial Máquina: <t t-out="currentOrder.fiscal_machine"/>
                </p>
                <p t-if="currentOrder.mf_reportz" class="text-muted mb-0" style="font-size: 0.9rem; font-weight: normal;">
                    Reporte Z: <t t-out="currentOrder.mf_reportz"/>
                </p>
            </div>
        </xpath>
    </t>
</templates>
